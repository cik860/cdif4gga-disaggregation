<https://w3id.org/cdif4gga/disagg/finance-channel/bilateral> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a channel value. Document earmarked finance through multilateral bodies separately; DAC classification differs from a simple institutional channel label. Reference: 18/CMA.1 Annex 121(d), 123; OECD 2026 Chapter 1 paragraphs 10 to 12"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-channel ;
    skos:prefLabel "bilateral"@en ;
    skos:topConceptOf gga:finance-channel .

<https://w3id.org/cdif4gga/disagg/finance-channel/multilateral> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a channel value, not instrument or finance origin. BTR channel and DAC bilateral or multilateral classification are not automatically equivalent. Reference: 18/CMA.1 Annex 121(d), 124; OECD 2026 Chapter 1 paragraphs 10 to 12"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-channel ;
    skos:prefLabel "multilateral"@en ;
    skos:topConceptOf gga:finance-channel .

<https://w3id.org/cdif4gga/disagg/finance-concessionality/concessional> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Split from \"concessional loan\" per domain review; record the applied concessionality rule"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-concessionality ;
    skos:prefLabel "concessional"@en ;
    skos:topConceptOf gga:finance-concessionality .

<https://w3id.org/cdif4gga/disagg/finance-concessionality/non-concessional> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Split from \"non-concessional loan\" per domain review"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-concessionality ;
    skos:prefLabel "non-concessional"@en ;
    skos:topConceptOf gga:finance-concessionality .

<https://w3id.org/cdif4gga/disagg/finance-instrument/equity> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep the broad instrument value. DAC/CRS 510 Common equity is a narrower example; do not use it for preferred equity or every equity holding. Reference: 18/CMA.1 Annex 121(f); OECD 2026 Chapter 1 paragraph 44; IATI replicated DAC Finance Type 510"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-instrument ;
    skos:prefLabel "equity"@en ;
    skos:topConceptOf gga:finance-instrument .

<https://w3id.org/cdif4gga/disagg/finance-instrument/grant> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as an instrument value. DAC/CRS 110 Standard grant is an illustrative narrower correspondence, not every grant related operation. Reference: 18/CMA.1 Annex 121(f); OECD 2026 Chapter 1 paragraph 35; IATI replicated DAC Finance Type 110"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-instrument ;
    skos:prefLabel "grant"@en ;
    skos:topConceptOf gga:finance-instrument .

<https://w3id.org/cdif4gga/disagg/finance-instrument/guarantee> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as an instrument. Record the exposure or contingent amount and avoid treating it as an ordinary disbursement. Select a specific DAC subtype only when known. Reference: 18/CMA.1 Annex 121(f), 121(m); OECD 2026 Chapter 1 paragraph 46; IATI Finance Type 1100 heading and 1101 to 1108 subtypes"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-instrument ;
    skos:prefLabel "guarantee"@en ;
    skos:topConceptOf gga:finance-instrument .

<https://w3id.org/cdif4gga/disagg/finance-instrument/insurance> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as an instrument with scope stated. Separate premium, coverage and payout; do not add insured face amount to ordinary finance flows. Reference: 18/CMA.1 Annex 121(f); OECD 2026 Chapter 1 paragraph 46. DAC heading 1100 combines guarantees and insurance, not an exact insurance code."@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-instrument ;
    skos:prefLabel "insurance"@en ;
    skos:topConceptOf gga:finance-instrument .

<https://w3id.org/cdif4gga/disagg/finance-instrument/loan> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Derived by splitting \"concessional/non-concessional loan\" into instrument (loan) plus concessionality, per domain review"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-instrument ;
    skos:prefLabel "loan"@en ;
    skos:topConceptOf gga:finance-instrument .

<https://w3id.org/cdif4gga/disagg/finance-origin-source/domestic> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep with a reference country and origin definition. Domestic is not synonymous with public finance; it is not an instrument. Reference: OECD 2026 Chapter 1 paragraphs 9 and 32; OECD classifications Mobilisation origin. Context reference, not a universal BTR code."@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-origin-source ;
    skos:prefLabel "domestic"@en ;
    skos:topConceptOf gga:finance-origin-source .

<https://w3id.org/cdif4gga/disagg/finance-origin-source/international> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep only with a reference country and explicit scope. International origin is not equivalent to multilateral channel or private mobilisation. Reference: OECD 2026 Chapter 1 paragraphs 9 and 32; source indicator context must govern nonfinance uses."@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-origin-source ;
    skos:prefLabel "international"@en ;
    skos:topConceptOf gga:finance-origin-source .

<https://w3id.org/cdif4gga/disagg/finance-origin-source/private-source> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Split from \"international private finance\": origin (international) and source (private) are distinct axes, per domain review"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:finance-origin-source ;
    skos:prefLabel "private source"@en ;
    skos:topConceptOf gga:finance-origin-source .

