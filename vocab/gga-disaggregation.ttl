        <https://w3id.org/cdif4gga/disagg/climate-hazards/storm-surge>,
        <https://w3id.org/cdif4gga/disagg/climate-hazards/tropical-cyclone>,
        <https://w3id.org/cdif4gga/disagg/climate-hazards/wildfire> ;
    skos:prefLabel "Climate-related hazards"@en .

gga:economic-sectors a skos:ConceptScheme ;
