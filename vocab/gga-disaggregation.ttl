    skos:hasTopConcept <https://w3id.org/cdif4gga/disagg/reporting-entities/direct-access-entities>,
        <https://w3id.org/cdif4gga/disagg/reporting-entities/party> ;
    skos:prefLabel "Reporting entity categories"@en .

