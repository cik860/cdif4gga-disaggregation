@prefix dct: <http://purl.org/dc/terms/> .
@prefix gga: <https://w3id.org/cdif4gga/disagg/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gga: a skos:Collection ;
    dct:description "Candidate vocabulary of recurring disaggregation dimensions and values for the Global Goal on Adaptation indicators, derived from the expert group compilation of 8 September 2025. Offered as a candidate input to the metadata work mandated to the UNFCCC Subsidiary Bodies; authority over the vocabulary rests with the UNFCCC process."@en ;
    dct:modified "2026-10-12"^^xsd:date ;
    skos:member gga:climate-hazards,
        gga:economic-sectors,
        gga:ecosystem-types,
        gga:employment-formality,
        gga:ews-components,
        gga:finance-channel,
        gga:finance-concessionality,
        gga:finance-instrument,
        gga:finance-origin-source,
        gga:geographic,
        gga:heritage,
        gga:knowledge-participation,
        gga:moi-support-activities,
        gga:planning-instruments,
        gga:reporting-entities,
        gga:social-categories,
        gga:support-perspective,
        gga:temporal,
        gga:thematic-targets ;
    skos:prefLabel "GGA disaggregation dimensions (candidate)"@en .

