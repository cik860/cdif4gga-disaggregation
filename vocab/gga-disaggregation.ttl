<https://w3id.org/cdif4gga/disagg/support-perspective/mobilised> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a mobilisation classification, not a disjoint third perspective beside provided and received. Define attribution and prevent double counting. Reference: 18/CMA.1 Annex 125, 121(m); OECD 2026 Chapter 1 paragraph 32 and Chapter 3 Section IV"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:support-perspective ;
    skos:prefLabel "mobilised"@en ;
    skos:topConceptOf gga:support-perspective .

<https://w3id.org/cdif4gga/disagg/support-perspective/provided> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep for provider reporting. Distinguish committed and disbursed status. Do not sum provided and received views of the same support. Reference: 18/CMA.1 Annex Chapter V, paragraphs 118 and 123 to 124; 121(c), 121(m)"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:support-perspective ;
    skos:prefLabel "provided"@en ;
    skos:topConceptOf gga:support-perspective .

<https://w3id.org/cdif4gga/disagg/support-perspective/received> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep for recipient reporting. Specify receipt and period. A received amount is not an additional instrument or a second flow to add to provider reporting. Reference: 18/CMA.1 Annex Chapter VI, paragraph 134; 12/CMA.7 Annex 12(d)"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:support-perspective ;
    skos:prefLabel "received"@en ;
    skos:topConceptOf gga:support-perspective .

