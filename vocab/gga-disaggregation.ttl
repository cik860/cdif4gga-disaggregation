    skos:historyNote "Verified against established vocabulary or accepted on KOS review"@en ;
    skos:inScheme gga:geographic ;
    skos:prefLabel "transboundary"@en ;
    skos:topConceptOf gga:geographic .

<https://w3id.org/cdif4gga/disagg/geographic/urban> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:historyNote "Verified against established vocabulary or accepted on KOS review"@en ;
    skos:inScheme gga:geographic ;
    skos:prefLabel "urban"@en ;
    skos:topConceptOf gga:geographic .

<https://w3id.org/cdif4gga/disagg/heritage/intangible-cultural-heritage-element> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a heritage category with the reporting unit defined. Classification should involve the relevant communities. Reference: UNESCO 2003 Convention Articles 2, 11(b) and 15"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:heritage ;
    skos:prefLabel "intangible cultural heritage element"@en ;
    skos:topConceptOf gga:heritage .

<https://w3id.org/cdif4gga/disagg/heritage/internationally-listed> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as designation status only with the named list and assessment date. It is not proof that all cultural heritage is internationally listed. Reference: UNESCO 2003 Convention Articles 16 and 17 for intangible heritage lists; full source context governs tangible lists"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:heritage ;
    skos:prefLabel "internationally listed"@en ;
    skos:topConceptOf gga:heritage .

<https://w3id.org/cdif4gga/disagg/knowledge-participation/indigenous-building-practices> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a practice attribute with a culturally appropriate definition and consent. Do not claim exact equivalence to traditional craftsmanship. Check Freq 2 versus one sampled indicator. Reference: 12/CMA.7 Annex paragraph 9; UNDRIP Article 31; UNESCO 2003 Convention Article 2(2)(e) is broader supporting context"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:knowledge-participation ;
    skos:prefLabel "indigenous building practices"@en ;
    skos:topConceptOf gga:knowledge-participation .

<https://w3id.org/cdif4gga/disagg/knowledge-participation/participatory-development-process> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a participation attribute. Define observable criteria and categories; it is not a policy instrument type. Reference: Expert technical report Section III paragraphs 25 and 31; 12/CMA.7 paragraph 10"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:knowledge-participation ;
    skos:prefLabel "participatory development process"@en ;
    skos:topConceptOf gga:knowledge-participation .

<https://w3id.org/cdif4gga/disagg/knowledge-participation/traditional-local-and-indigenous-peoples-knowledge-and-practices> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Recovered full phrase per domain review (the truncated extraction \"guided by traditional\" was excluded); decision-text phrase"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:knowledge-participation ;
    skos:prefLabel "traditional, local and Indigenous Peoples’ knowledge and practices"@en ;
    skos:topConceptOf gga:knowledge-participation .

<https://w3id.org/cdif4gga/disagg/moi-support-activities/adaptation-technology-development> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a support activity within Finance and means of implementation. Development and transfer are related but not interchangeable. Reference: 12/CMA.7 Annex 12(e); 18/CMA.1 Annex 127, 136, 138"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:moi-support-activities ;
    skos:prefLabel "adaptation technology development"@en ;
    skos:topConceptOf gga:moi-support-activities .

<https://w3id.org/cdif4gga/disagg/moi-support-activities/capacity-building-component> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a component dimension in Finance and means of implementation. Component values need definitions; the label alone is not a completed codelist. Reference: 12/CMA.7 Annex 12(f); 18/CMA.1 Annex 129, 140, 142"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:moi-support-activities ;
    skos:prefLabel "capacity-building component"@en ;
    skos:topConceptOf gga:moi-support-activities .

<https://w3id.org/cdif4gga/disagg/planning-instruments/policy> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a planning instrument type. Explain overlap with plan and strategy rather than merging them without a rule. Reference: 12/CMA.7 Annex 11(a); expert compilation samples 10b02 and 10b06"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:planning-instruments ;
    skos:prefLabel "policy"@en ;
    skos:topConceptOf gga:planning-instruments .

<https://w3id.org/cdif4gga/disagg/planning-instruments/strategy> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as a planning instrument type distinct from policy and plan, with overlaps documented. Reference: 12/CMA.7 Annex 11(a); expert samples 10b02 and 10b06"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:planning-instruments ;
    skos:prefLabel "strategy"@en ;
    skos:topConceptOf gga:planning-instruments .

<https://w3id.org/cdif4gga/disagg/reporting-entities/direct-access-entities> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as an entity category associated with direct access. It is not a financial instrument and does not replace a recipient or provider identifier. Reference: GCF in Brief: Direct access, 1 December 2021"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:reporting-entities ;
    skos:prefLabel "direct access entities"@en ;
    skos:topConceptOf gga:reporting-entities .

<https://w3id.org/cdif4gga/disagg/reporting-entities/party> a skos:Concept ;
    dct:source "Expert group indicator compilation, 8 September 2025 (free-text disaggregation column)"@en ;
    skos:editorialNote "Keep as the reporting entity dimension, not an instrument value. Use separate jurisdiction identifiers; no country code is assigned here. Reference: 12/CMA.7 paragraphs 11 to 12; expert samples 9e06 and 9e07"@en ;
    skos:historyNote "Accepted on climate-domain review (October 2026)"@en ;
    skos:inScheme gga:reporting-entities ;
    skos:prefLabel "Party"@en ;
    skos:topConceptOf gga:reporting-entities .

