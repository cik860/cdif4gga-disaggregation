gga:thematic-targets a skos:ConceptScheme ;
    skos:editorialNote "The seven thematic targets of the UAE Framework (decision 2/CMA.5 para 9) — a policy target axis, distinct from ecosystem types per domain review"@en ;
    skos:hasTopConcept <https://w3id.org/cdif4gga/disagg/thematic-targets/cultural-heritage>,
        <https://w3id.org/cdif4gga/disagg/thematic-targets/ecosystems-and-biodiversity>,
        <https://w3id.org/cdif4gga/disagg/thematic-targets/food-and-agriculture>,
        <https://w3id.org/cdif4gga/disagg/thematic-targets/health>,
        <https://w3id.org/cdif4gga/disagg/thematic-targets/infrastructure-and-human-settlements>,
        <https://w3id.org/cdif4gga/disagg/thematic-targets/poverty-eradication-and-livelihoods>,
        <https://w3id.org/cdif4gga/disagg/thematic-targets/water> ;
    skos:prefLabel "Thematic targets"@en .

gga:climate-hazards a skos:ConceptScheme ;
    skos:editorialNote "Derived top-down from the UNDRR-ISC Hazard Information Profiles; verified against hazard lists in indicator definitions"@en ;
    skos:hasTopConcept <https://w3id.org/cdif4gga/disagg/climate-hazards/drought>,
        <https://w3id.org/cdif4gga/disagg/climate-hazards/flood>,
        <https://w3id.org/cdif4gga/disagg/climate-hazards/heatwave>,
