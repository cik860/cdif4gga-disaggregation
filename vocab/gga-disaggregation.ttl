    skos:hasTopConcept <https://w3id.org/cdif4gga/disagg/finance-origin-source/domestic>,
        <https://w3id.org/cdif4gga/disagg/finance-origin-source/international>,
        <https://w3id.org/cdif4gga/disagg/finance-origin-source/private-source> ;
    skos:prefLabel "Finance origin and source"@en .

gga:knowledge-participation a skos:ConceptScheme ;
